# ─── Database ──────────────────────────────────────────
POSTGRES_USER=collab_user
POSTGRES_PASSWORD=collab_secret
POSTGRES_DB=collab_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://collab_user:collab_secret@localhost:5432/collab_db?schema=public"

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Application ───────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Rate Limiting ─────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
